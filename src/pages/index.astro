---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
import { areas } from '../data/areas.js';
import { posts } from '../data/posts.js';
---
<Base description="Alicia Unruh is a lifelong Utahn and bilingual REALTOR® helping buyers and sellers across the Heber Valley, Park City, Utah County, Salt Lake, Tooele and Davis counties.">
  <section class="hero">
    <div class="wrap hero-in">
      <div class="copy">
        <p class="eyebrow">Heber Valley · Wasatch Back · All of Utah</p>
        <h1>Find your <em>place</em> in Utah's mountains and valleys.</h1>
        <p class="lead">I'm Alicia, a lifelong Utahn and REALTOR® who loves walking beside people as they take a big step. Mountain town, quiet valley or somewhere in between, I'll help you find the one that fits.</p>
        <div class="cta"><a href="/contact" class="btn">Start a conversation</a><a href="/areas" class="btn ghost">Explore the areas</a></div>
      </div>
      <figure class="portrait">
        <img src="/images/alicia-laugh.jpg" alt="Alicia Unruh laughing outdoors" width="894" height="1024" />
        <figcaption>Heber Valley is home.</figcaption>
      </figure>
    </div>
    <svg class="hero-mtn" viewBox="0 0 1440 260" preserveAspectRatio="none" aria-hidden="true">
      <path fill="#b9d0e8" opacity=".6" d="M0 150 L110 90 L200 130 L340 40 L470 120 L560 80 L700 160 L830 60 L960 130 L1080 70 L1220 140 L1330 80 L1440 120 V260 H0Z"/>
      <path fill="#6a9bd0" opacity=".8" d="M0 180 L140 120 L250 168 L400 96 L520 170 L660 112 L790 186 L930 106 L1060 176 L1190 114 L1320 170 L1440 130 V260 H0Z"/>
      <path fill="#143f6b" d="M0 220 L160 176 L300 214 L470 160 L620 218 L780 170 L940 220 L1100 168 L1260 216 L1440 178 V260 H0Z"/>
    </svg>
  </section>

  <section class="band-navy">
    <div class="wrap two">
      <div>
        <p class="eyebrow light">Mountain or valley?</p>
        <h2>Utah is more than one place.</h2>
        <p>Ski-town energy in Park City, ranch land in Kamas, family neighborhoods in Orem, wide skies in Tooele. Each has its own pace, price and personality. I've lived and worked in many of them, so I can tell you which one feels like yours.</p>
      </div>
      <ul class="elev">
        <li><span>Summit</span><b>Park City · Kamas · Oakley</b></li>
        <li><span>High valley</span><b>Heber · Midway</b></li>
        <li><span>Foothills</span><b>Salt Lake · Utah · Davis</b></li>
        <li><span>Open basin</span><b>Tooele County</b></li>
      </ul>
    </div>
  </section>
  <Ridge fill="#f6f1e7" back="#6a9bd0" class="r1" />

  <section class="story wrap cols">
    <div class="photos">
      <img src="/images/alicia-sofa.jpg" alt="Alicia seated in a model home living room" class="photo" width="682" height="1024" loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Meet Alicia</p>
      <h2>Real estate is really about people.</h2>
      <p>I love how real estate connects me with the lives of others: their stories, passions, dreams and journeys. One of the most rewarding parts of being a REALTOR® is walking alongside new friends as they take a big next step, and watching the freedom and excitement of homeownership arrive.</p>
      <p>Born in Cache County, raised in Weber and Davis, and working across Davis, Salt Lake, Utah and Tooele counties, I now call the Heber Valley home. My goal is simple: take the fear and the unknown out of the process so you can enjoy what matters.</p>
      <ul class="creds">
        <li>Past President, Tooele County Association of REALTORS®</li>
        <li>Fluent in Spanish</li>
      </ul>
      <a href="/about" class="btn ghost">Read my story</a>
    </div>
  </section>

  <section class="home-pc">
    <div class="wrap home-pc-in">
      <div>
        <p class="eyebrow">Postcards from home</p>
        <h2>Willkommen to Midway.</h2>
        <p>Just up the road from Heber, Midway is all Swiss chalets, painted shutters and Christmas shops that stay open year-round. It's one of my favorite places to show people what life in the Heber Valley really feels like.</p>
        <a href="/areas/wasatch-county" class="btn ghost">Explore Wasatch County</a>
      </div>
      <div class="pc-stack">
        <figure class="hp hp0"><img src="/images/midway-willkommen.jpg" alt="Hand-painted Willkommen Midway Utah sign on Midway Town Hall" width="900" height="1200" loading="lazy" decoding="async" /><figcaption>Midway Town Hall</figcaption></figure>
        <figure class="hp hp1"><img src="/images/midway-kringles.jpg" alt="Vintage sleigh outside Kringles Christmas shop in Midway, Utah" width="900" height="1200" loading="lazy" decoding="async" /><figcaption>Kringles, Midway</figcaption></figure>
      </div>
    </div>
  </section>

  <section class="areas-sec">
    <div class="wrap">
      <p class="eyebrow">Where I work</p>
      <h2>Six counties. One local guide.</h2>
      <div class="area-list">
        {areas.map((a, i) => (
          <a href={`/areas/${a.slug}`} class="area">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="c"><b>{a.county}</b><small>{a.towns}</small></span>
            <span class="m">{a.motto}</span>
            <span class="go">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="who wrap">
    <p class="eyebrow">Who I help</p>
    <h2>Wherever you are on the trail.</h2>
    <div class="who-grid">
      <div><h3>First-time buyers</h3><p>Plain answers, no jargon, and someone who will not rush you.</p></div>
      <div><h3>New to Utah</h3><p>Relocating? I'll introduce you to the communities and what daily life is like in each.</p></div>
      <div><h3>Ready to sell</h3><p>A clear plan and honest pricing so you can move on to your next chapter.</p></div>
      <div><h3>Leaving for adventure</h3><p>Moving away from Utah? I'll handle the details while you plan the road ahead.</p></div>
    </div>
  </section>

  <section class="band-sky">
    <div class="wrap cols">
      <img src="/images/alicia-and-jason.jpg" alt="Alicia and her husband smiling in a grassy field" class="photo" width="960" height="640" loading="lazy" />
      <div>
        <p class="eyebrow">Hablo español</p>
        <h2>Una guía de confianza, en su idioma.</h2>
        <p>I speak Spanish fluently and love helping Spanish-speaking families find a home in Utah. <em>Estoy aquí para ayudarle en cada paso.</em></p>
        <a href="/contact" class="btn">Contáctame / Contact me</a>
      </div>
    </div>
  </section>

  <section class="notes wrap">
    <p class="eyebrow">Field notes</p>
    <h2>Stories from around the state.</h2>
    <div class="note-grid">
      {posts.slice(0, 3).map(p => (
        <a href={`/blog/${p.slug}`} class="note">
          <small>{p.kicker}</small>
          <h3>{p.title}</h3>
          <p>{p.excerpt}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="closing">
    <div class="narrow">
      <h2>Ready for your next adventure?</h2>
      <p>Tell me where you're headed. I'll help you get there with confidence.</p>
      <a href="/contact" class="btn">Contact Alicia</a>
    </div>
  </section>
</Base>

<style>
  .hero{background:linear-gradient(180deg,#dfe9f4 0%,#f6f1e7 70%);position:relative;overflow:hidden;padding-top:4rem}
  .hero-in{display:grid;grid-template-columns:1.25fr .8fr;gap:3rem;align-items:center;position:relative;z-index:2;padding-bottom:9rem}
  .hero h1{max-width:14ch}
  .lead{font-size:1.25rem;max-width:34em;margin-bottom:1.8rem}
  .cta{display:flex;gap:1rem;flex-wrap:wrap}
  .portrait{margin:0;position:relative}
  .portrait img{border-radius:220px 220px 6px 6px;aspect-ratio:4/5;object-fit:cover;object-position:50% 25%;box-shadow:14px 14px 0 var(--navy)}
  .portrait figcaption{position:absolute;left:-1rem;bottom:1.2rem;background:var(--paper);padding:.35rem .9rem;font-family:var(--serif);font-style:italic;box-shadow:3px 3px 0 var(--clay)}
  .hero-mtn{position:absolute;left:0;right:0;bottom:0;width:100%;height:clamp(120px,18vw,260px);z-index:1}
  @media(max-width:820px){.hero-in{grid-template-columns:1fr;padding-bottom:7rem}.portrait{max-width:340px}}

  .band-navy{background:var(--navy);color:#e4eef9;padding:4rem 0 3rem}
  .band-navy h2{color:#fff}
  .eyebrow.light{color:#9cc0e6}
  .two{display:grid;grid-template-columns:1.1fr 1fr;gap:3rem;align-items:center}
  .elev{list-style:none;margin:0;padding:0;border-left:2px solid #6a9bd0}
  .elev li{padding:.9rem 0 .9rem 1.4rem;position:relative;border-bottom:1px dashed #ffffff33}
  .elev li::before{content:"";position:absolute;left:-7px;top:1.4rem;width:12px;height:12px;background:var(--clay);transform:rotate(45deg)}
  .elev span{display:block;font-size:.75rem;letter-spacing:.16em;text-transform:uppercase;color:#9cc0e6}
  .elev b{font-family:var(--serif);font-size:1.3rem;color:#fff;font-weight:600}
  @media(max-width:820px){.two{grid-template-columns:1fr}}
  :global(.r1){background:var(--navy)}

  .story{padding:4rem 0}
  .photos{max-width:420px}
  .creds{padding:0;list-style:none;margin:1.2rem 0 1.6rem;border-top:1px solid var(--line)}
  .creds li{padding:.55rem 0;border-bottom:1px solid var(--line);font-weight:500}
  .creds li::before{content:"▲ ";color:var(--sky);font-size:.7em}

  .home-pc{padding:1rem 0 5rem;overflow:hidden}
  .home-pc-in{display:grid;grid-template-columns:1fr 1.1fr;gap:3rem;align-items:center}
  .pc-stack{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
  .hp{margin:0;background:#fff;padding:.7rem .7rem 0;box-shadow:0 12px 30px #143f6b26;transition:transform .3s}
  .hp0{transform:rotate(-3deg)}
  .hp1{transform:rotate(2.5deg);margin-top:3rem}
  .hp:hover{transform:rotate(0) translateY(-6px)}
  .hp img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}
  .hp figcaption{font-family:var(--serif);font-style:italic;text-align:center;padding:.6rem 0 .8rem;color:var(--navy);font-size:.95rem}
  @media(max-width:820px){.home-pc-in{grid-template-columns:1fr}}

  .areas-sec{background:var(--paper2);padding:4.5rem 0}
  .area-list{margin-top:2rem;border-top:2px solid var(--ink)}
  .area{display:grid;grid-template-columns:3.2rem 1.3fr 1.2fr 2rem;gap:1rem;align-items:center;padding:1.2rem .4rem;text-decoration:none;color:var(--ink);border-bottom:1px solid var(--line);transition:background .2s,padding .2s}
  .area:hover{background:#fff8;padding-left:1.2rem}
  .area .n{font-family:var(--serif);color:var(--sky);font-size:1.4rem}
  .area b{font-family:var(--serif);font-size:1.5rem;display:block;font-weight:600}
  .area small{color:#5b6b7c}
  .area .m{font-style:italic;font-family:var(--serif)}
  .area .go{color:var(--clay);font-size:1.4rem}
  @media(max-width:760px){.area{grid-template-columns:2.4rem 1fr 1.4rem}.area .m{display:none}}

  .who{padding:5rem 0}
  .who-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-top:2rem}
  .who-grid div{border-top:3px solid var(--navy);padding-top:1rem}
  .who-grid h3{font-size:1.25rem}
  @media(max-width:900px){.who-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.who-grid{grid-template-columns:1fr}}

  .band-sky{background:#dfe9f4;padding:4.5rem 0}
  .notes{padding:5rem 0}
  .note-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.6rem;margin-top:2rem}
  .note{background:#fff9;border:1px solid var(--line);padding:1.6rem;text-decoration:none;color:var(--ink);transition:transform .2s,box-shadow .2s}
  .note:hover{transform:translateY(-4px);box-shadow:6px 6px 0 var(--sky)}
  .note small{color:var(--clay);font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:.72rem}
  .note h3{margin-top:.5rem}
  .note p{margin:0;color:#4a5a6b;font-size:.98rem}
  @media(max-width:900px){.note-grid{grid-template-columns:1fr}}

  .closing{text-align:center;padding:5rem 0 3rem}
</style>
