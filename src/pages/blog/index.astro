---
import Base from '../../layouts/Base.astro';
import { posts } from '../../data/posts.js';
const fmt = d => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Field Notes" description="Stories, quirks and local knowledge from Utah's mountains and valleys.">
  <section class="page-head"><div class="wrap"><p class="eyebrow">Field notes</p><h1>Stories from the <em>mountains and valleys.</em></h1></div></section>
  <section class="narrow list">
    {posts.map(p => (
      <a href={`/blog/${p.slug}`}>
        <small>{p.kicker} · {fmt(p.date)}</small>
        <h2>{p.title}</h2>
        <p>{p.excerpt}</p>
      </a>
    ))}
  </section>
</Base>
<style>
  .list{padding:3rem 0 5rem}
  .list a{display:block;text-decoration:none;color:var(--ink);padding:1.6rem 0;border-bottom:1px solid var(--line)}
  .list a:hover h2{color:var(--clay)}
  .list small{color:var(--clay);font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-size:.74rem}
  .list h2{margin:.3rem 0;font-size:1.9rem;transition:color .2s}
</style>
